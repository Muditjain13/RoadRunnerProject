{
  "name": "RoadRunner Transport",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26.6"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  "forwardPorts": [8080, 16686, 9090],
  "portsAttributes": {
    "8080": { "label": "Web app and REST API (gateway)", "onAutoForward": "notify" },
    "16686": { "label": "Jaeger traces", "onAutoForward": "silent" },
    "9090": { "label": "Prometheus", "onAutoForward": "silent" }
  },

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends jq && go mod download",

  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "ms-azuretools.vscode-docker"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
